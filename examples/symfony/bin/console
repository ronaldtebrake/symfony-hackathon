#!/usr/bin/env php
<?php

declare(strict_types=1);

use Adoption\Kernel;
use Symfony\Bundle\FrameworkBundle\Console\Application;
use Symfony\Component\Dotenv\Dotenv;

require dirname(__DIR__).'/vendor/autoload.php';
if (is_file(dirname(__DIR__).'/.env.local')) {
    (new Dotenv())->load(dirname(__DIR__).'/.env.local');
}
// example app: no cookies or signed URLs persist between processes.
$_SERVER['APP_SECRET'] ??= bin2hex(random_bytes(32));

// Keep the two compiled configurations separate when reproducing the historical PHP proof.
exit((new Application(new Kernel('php' === getenv('ADOPTION_MODE') ? 'php' : 'catalog', false)))->run());
