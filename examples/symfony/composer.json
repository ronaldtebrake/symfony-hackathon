{
    "name": "symfony-code-mode/adoption-example",
    "description": "Independent Symfony consumer proving approved native tools and per-call authorization.",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "beta",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "nyholm/psr7": "^1.8",
        "ronaldtebrake/symfony-code-mode": "^0.1",
        "symfony/ai-agent": "^1.0@beta",
        "symfony/ai-bundle": "^1.0@beta",
        "symfony/dotenv": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/security-bundle": "7.4.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/maker-bundle": "^1.64",
        "symfony/web-profiler-bundle": "7.4.*"
    },
    "autoload": {
        "psr-4": {
            "Adoption\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/*",
            "options": {
                "symlink": false,
                "versions": {
                    "ronaldtebrake/php-code-mode": "0.1.0",
                    "ronaldtebrake/symfony-code-mode": "0.1.0"
                }
            }
        }
    ],
    "scripts": {
        "test": "@php vendor/bin/phpunit --bootstrap vendor/autoload.php tests",
        "check": [
            "@composer validate --strict",
            "@php bin/console lint:container",
            "@test"
        ],
        "proof": "@php scripts/proof.php",
        "proof:catalog": "@php scripts/catalog-proof.php",
        "proof:http": "@php scripts/http-proof.php",
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@php -S 127.0.0.1:8001 -t public public/index.php"
        ]
    }
}
