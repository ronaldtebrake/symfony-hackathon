<?php

/**
 * @file
 * Access restriction only for the separately provisioned synthetic fixture.
 */

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\Core\Session\AccountInterface;

function code_mode_surface_proof_entity_field_access($operation, FieldDefinitionInterface $definition, AccountInterface $account, ?FieldItemListInterface $items = NULL) {
  if ($operation === 'view' && $definition->getName() === 'title' && $items
    && $items->getEntity()->uuid() === 'a20d7ff8-640c-4911-a234-000000000005') {
    // Never grant access: the fixture's title is unavailable to every reader.
    return AccessResult::forbidden('Fixture field access is restricted.')->setCacheMaxAge(0);
  }
  return AccessResult::neutral();
}
