            "programs": [
                "$articles = [];\n$offset = 0;\ndo {\n    $page = $tools->call('cms_list_articles', ['offset' => $offset, 'limit' => 12]);\n    $ids = array_map(static fn ($item) => $item->id, $page->items);\n    if ($ids !== []) {\n        $details = $tools->call('cms_get_articles', ['ids' => $ids]);\n        array_push($articles, ...$details->items);\n    }\n    $offset = $page->next_offset;\n} while ($offset !== null);\n\n$imageIds = array_values(array_unique(array_map(static fn ($article) => $article->image_id, $articles)));\n$media = [];\nforeach (array_chunk($imageIds, 12) as $batch) {\n    $images = $tools->call('cms_get_media', ['ids' => $batch]);\n    foreach ($images->items as $image) {\n        $media[$image->id] = $image;\n    }\n}\n\n$findings = [];\nforeach ($articles as $article) {\n    $issues = [];\n    if (trim($article->meta_description) === '') {\n        $issues[] = 'missing_description';\n    }\n    if (trim($media[$article->image_id]->alt) === '') {\n        $issues[] = 'missing_alt';\n    }\n    if ($issues !== []) {\n        $findings[] = ['id' => $article->id, 'title' => $article->title, 'issues' => $issues];\n    }\n}\nusort($findings, static fn ($a, $b) => $a['id'] <=> $b['id']);\nreturn ['audited' => count($articles), 'findings' => $findings];\n"
