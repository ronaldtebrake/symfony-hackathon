{
    "name": "ronaldtebrake/php-code-mode",
    "description": "Isolated PHP execution with a host-authorized tool broker.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-pcntl": "*",
        "ext-posix": "*",
        "mcp/sdk": "^0.9",
        "opis/json-schema": "^2.6",
        "symfony/process": "^7.4"
    },
    "require-dev": {"phpunit/phpunit": "^11.5"},
    "autoload": {"psr-4": {"CodeMode\\": "src/"}},
    "autoload-dev": {"psr-4": {"CodeMode\\Tests\\": "tests/"}},
    "scripts": {
        "test": "phpunit --testsuite Unit",
        "test:sandbox": "phpunit --testsuite Sandbox"
    },
    "config": {"sort-packages": true, "allow-plugins": {"php-http/discovery": false}},
    "archive": {"exclude": ["/vendor", "/.phpunit.cache", "/composer.lock", "/phpunit.xml"]}
}
