{
    "name": "ronaldtebrake/symfony-hackathon",
    "type": "project",
    "license": "MIT",
    "description": "Symfony Code Mode: approved JSON tool catalogs and sandboxed PHP with Symfony AI and the PHP MCP SDK.",
    "minimum-stability": "beta",
    "prefer-stable": true,
    "require": {
        "ext-ctype": "*",
        "ext-fileinfo": "*",
        "ext-iconv": "*",
        "mcp/sdk": "^0.9",
        "nyholm/psr7": "^1.8",
        "php": ">=8.2",
        "ronaldtebrake/php-code-mode": "^0.1",
        "ronaldtebrake/symfony-code-mode": "^0.1",
        "symfony/ai-agent": "^1.0@beta",
        "symfony/ai-bundle": "^1.0@beta",
        "symfony/ai-hugging-face-platform": "^1.0@beta",
        "symfony/ai-platform": "^1.0@beta",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/mcp-bundle": "^1.0@beta",
        "symfony/runtime": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "7.4.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
            "CodeMode\\Tests\\": "packages/php-code-mode/tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@php -S 127.0.0.1:8000 -t public public/index.php"
        ],
        "test": "@php bin/phpunit",
        "test:package": "@php bin/phpunit -c packages/php-code-mode/phpunit.dist.xml --testsuite Unit",
        "test:data-surface": "@php bin/phpunit --bootstrap vendor/autoload.php examples/drupal-surface-query/tests",
        "test:sandbox": "@php bin/phpunit -c packages/php-code-mode/phpunit.dist.xml --testsuite Sandbox",
        "test:demo": "@php bin/phpunit -c phpunit.sandbox.xml",
        "proof:code-mode": "@php packages/php-code-mode/examples/proof.php",
        "demo": "@php bin/console code-mode:demo",
        "demo:security": "@php bin/console code-mode:security-proof",
        "check": [
            "@composer validate --strict",
            "@composer validate --strict --working-dir=packages/php-code-mode",
            "@composer validate --strict --working-dir=packages/symfony-code-mode",
            "@php bin/console lint:yaml config --parse-tags",
            "@php bin/console lint:container --resolve-env-vars",
            "@test",
            "@test:package",
            "@test:data-surface"
        ],
        "docs:build": "@php scripts/build-docs.php"
    },
    "scripts-descriptions": {
        "start": "Start the local development server at http://127.0.0.1:8000",
        "test": "Run the tests without external API calls",
        "check": "Validate dependencies, configuration, and integration tests",
        "docs:build": "Build static visual documentation from reviewed evidence only"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/php-code-mode",
            "options": {
                "versions": {
                    "ronaldtebrake/php-code-mode": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "packages/symfony-code-mode",
            "options": {
                "versions": {
                    "ronaldtebrake/symfony-code-mode": "0.1.0"
                }
            }
        }
    ]
}
