{
    "name": "ronaldtebrake/symfony-hackathon",
    "type": "project",
    "license": "MIT",
    "description": "Discover approved Symfony AI tools and named procedures over MCP, with an application permission check on every read.",
    "minimum-stability": "beta",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-fileinfo": "*",
        "ext-iconv": "*",
        "mcp/sdk": "^0.9",
        "nyholm/psr7": "^1.8",
        "ronaldtebrake/php-code-mode": "^0.1",
        "ronaldtebrake/symfony-code-mode": "^0.1",
        "symfony/ai-agent": "^1.0@beta",
        "symfony/ai-bundle": "^1.0@beta",
        "symfony/ai-hugging-face-platform": "^1.0@beta",
        "symfony/ai-mcp-tool": "^1.0@beta",
        "symfony/ai-platform": "^1.0@beta",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/mcp-bundle": "^1.0@beta",
        "symfony/runtime": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "require-dev": {
        "php-cs-fixer/shim": "^3.91.2",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "7.4.*",
        "symfony/maker-bundle": "^1.64",
        "symfony/web-profiler-bundle": "7.4.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
            "CodeMode\\Tests\\": "packages/php-code-mode/tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@php -S 127.0.0.1:8000 -t public public/index.php"
        ],
        "demo:serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php scripts/refund-recording.php serve --catalog --rehearsal --profile"
        ],
        "demo:token": "@php scripts/refund-recording.php token --rehearsal",
        "demo:chat": "App\\Demo\\RefundRecording\\InteractiveChatCommand",
        "test": "@php bin/phpunit",
        "test:package": "@php bin/phpunit -c packages/php-code-mode/phpunit.dist.xml --testsuite Unit",
        "test:sandbox": "@php bin/phpunit -c packages/php-code-mode/phpunit.dist.xml --testsuite Sandbox",
        "test:demo": "@php bin/phpunit -c phpunit.sandbox.xml",
        "proof:discovery": "@php scripts/verify-demo.php",
        "cs:check": [
            "@php vendor/bin/php-cs-fixer check --config=.php-cs-fixer.dist.php --diff --sequential",
            "@php scripts/check-maker.php style"
        ],
        "cs:fix": "@php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --sequential",
        "phpstan": [
            "@php vendor/bin/phpstan analyse --configuration=phpstan.dist.neon --memory-limit=1G --no-progress",
            "@php scripts/check-maker.php phpstan"
        ],
        "check": [
            "@composer validate --strict",
            "@composer validate --strict --working-dir=packages/php-code-mode",
            "@composer validate --strict --working-dir=packages/symfony-code-mode",
            "@cs:check",
            "@phpstan",
            "@php bin/console lint:yaml config --parse-tags",
            "@php bin/console lint:container --resolve-env-vars",
            "@test",
            "@test:package"
        ],
        "docs:build": "@php scripts/build-docs.php"
    },
    "scripts-descriptions": {
        "demo:serve": "Start the local Symfony MCP catalog for your MCP client",
        "demo:chat": "Open your signed-in Claude Code or Codex CLI against a fresh Symfony refund catalog",
        "proof:discovery": "Verify the judge demo over HTTP with the PHP MCP SDK, including a denied read after revocation",
        "start": "Start the local development server at http://127.0.0.1:8000",
        "test": "Run the tests without external API calls",
        "check": "Check Symfony coding standards, static analysis, dependencies, configuration, and tests",
        "phpstan": "Analyse packages, applications, tests, CLI scripts and generated Maker code at level 5",
        "cs:check": "Check Symfony PHP coding standards across the repository without changing files",
        "cs:fix": "Apply Symfony PHP coding standards across the repository; review the diff before committing",
        "docs:build": "Build static visual documentation from reviewed evidence only"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/php-code-mode",
            "options": {
                "versions": {
                    "ronaldtebrake/php-code-mode": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "packages/symfony-code-mode",
            "options": {
                "versions": {
                    "ronaldtebrake/symfony-code-mode": "0.1.0"
                }
            }
        }
    ]
}
